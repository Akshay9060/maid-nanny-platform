# Server port (optional, defaults to 5000)
PORT=5000

# MongoDB connection string
# Use your own local or cloud MongoDB URI
MONGO_URI=mongodb://localhost:27017/maidnanny

# JWT secret – use a long, random string (never commit this!)
JWT_SECRET=your_very_strong_secret_key_here

# JWT expiration (e.g., 7d, 1h)
JWT_EXPIRES_IN=7d
