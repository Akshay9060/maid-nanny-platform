# server/.env.example
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Seed credentials (only used if you run seed script)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=YourStrongAdminPassword
SEED_HOUSEHOLD_EMAIL=household@yourdomain.com
SEED_HOUSEHOLD_PASSWORD=YourStrongHouseholdPassword
SEED_HELPER_EMAIL=helper@yourdomain.com
SEED_HELPER_PASSWORD=YourStrongHelperPassword